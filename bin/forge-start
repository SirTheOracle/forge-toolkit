#!/bin/bash
# ============================================================
# forge-start — Launch a forge tmux session
# ============================================================
#
# Layout:
#   ┌─────────────────────────────────────┐
#   │ Pane 0 — Claude Opus orchestrator   │
#   ├──────────────────┬──────────────────┤
#   │ Pane 1           │ Pane 3           │
#   │ Claude Opus      │ Codex A          │
#   ├──────────────────┼──────────────────┤
#   │ Pane 2           │ Pane 4           │
#   │ Claude Sonnet    │ Codex B          │
#   └──────────────────┴──────────────────┘
#
# Usage:
#   forge-start [--here] [--allow-dirty-base] [name]
#   forge-start --populate-existing <name>
#
# Plain starts provision a Git worktree by default, under .forge-worktrees/
# inside the project being worked on (anchored at the main working tree, so
# starting from a worktree does not nest). --here (or FORGE_START_WORKTREE=0)
# keeps the current physical root; use it while working on forge-toolkit itself
# because the installed launchers point at this checkout.
# ============================================================

set -e

BRIDGE_BIN="${FORGE_BRIDGE_BIN:-$HOME/bin/forge-bridge}"
FORGE_BIN="${FORGE_BIN:-$HOME/bin/forge}"
FORGE_CODEX_DOCTOR_BIN="${FORGE_CODEX_DOCTOR_BIN:-$HOME/bin/forge}"
FORGE_START_WORKTREE="${FORGE_START_WORKTREE:-1}"
FORGE_START_CODEX_PREFLIGHT="${FORGE_START_CODEX_PREFLIGHT:-1}"

DIR="$(pwd)"
POPULATE=0
ALLOW_DIRTY=""
FORGE_LAYOUT_VERSION="${FORGE_LAYOUT_VERSION:-2}"

# Plain-mode flags are shifted before the existing positional-name branch.
while [ $# -gt 0 ]; do case "$1" in
    --here) FORGE_START_WORKTREE=0; shift ;;
    --allow-dirty-base) ALLOW_DIRTY=1; shift ;;
    *) break ;;
esac; done

# Test hook (addendum 4): force a mid-layout failure ONLY in populate mode so the
# error-trap's partial-split contract is exercisable. No-op in manual mode.
_maybe_fail() {
    [ "$POPULATE" = 1 ] || return 0
    if [ "${FORGE_START_FAIL_AFTER:-}" = "$1" ]; then
        echo "forge-start: INJECTED failure after step '$1' (FORGE_START_FAIL_AFTER)" >&2
        false
    fi
}

# Tear down ONLY what this run created: panes split off pane 0 (index >= 1).
# Never kill the session. Never touch .dev/.forge-session: a file this run wrote
# names the still-alive session and is valid even on failure — removing it would
# be the regression the v1 debt contract warns about.
_populate_teardown() {
    tmux list-panes -t "$SESSION" -F '#{pane_index}' 2>/dev/null | sort -rn | while read -r _i; do
        if [ "$_i" -ge 1 ]; then tmux kill-pane -t "$SESSION:.$_i" 2>/dev/null || true; fi
    done
}

# EXIT trap + success sentinel: catches every abort path INCLUDING explicit
# `exit 1` branches (an ERR trap would not fire on those). Reports the partial
# split, tears down added panes, exits nonzero.
_POPULATE_OK=0
_FAIL_REASON="mid-layout"
_populate_trap() {
    if [ "$_POPULATE_OK" = 1 ]; then return 0; fi
    local now
    now="$(tmux list-panes -t "$SESSION" -F '#{pane_index}' 2>/dev/null | grep -c . || echo '?')"
    echo "ERROR: forge-start --populate-existing failed: $_FAIL_REASON — partial-split state: $now pane(s)." >&2
    echo "       Session left ALIVE (never killed); tearing down only the panes this run added." >&2
    _populate_teardown
    exit 1
}

if [ "${1:-}" = "--populate-existing" ]; then
    POPULATE=1
    SESSION="${2:-}"
    [ -n "$SESSION" ] || { echo "ERROR: --populate-existing requires <session>" >&2; exit 2; }
    tmux has-session -t "$SESSION" 2>/dev/null \
        || { echo "ERROR: --populate-existing: session '$SESSION' does not exist" >&2; exit 2; }
    _pc=$(tmux list-panes -t "$SESSION" -F '#{pane_index}' 2>/dev/null | grep -c .)
    [ "$_pc" = 1 ] \
        || { echo "ERROR: --populate-existing requires a 1-pane session ('$SESSION' has $_pc)" >&2; exit 2; }
    DIR="$(tmux display-message -p -t "$SESSION" '#{session_path}')"
    trap _populate_trap EXIT
elif [ -n "${1:-}" ]; then
    SESSION="$1"
else
    COUNT=1
    while tmux has-session -t "forge-$COUNT" 2>/dev/null; do
        COUNT=$((COUNT + 1))
    done
    SESSION="forge-$COUNT"
fi

if [ "$POPULATE" = 0 ]; then
    # Auto-naming's loop already proved its selected name absent; explicit names
    # need the same pre-provision check without adding a second HC4 tmux call.
    if [ -n "${1:-}" ] && tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "forge-start: session '$SESSION' already exists — attach with: tmux attach -t $SESSION" >&2
        exit 2
    fi
    SOURCE_ROOT="$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null)" \
        || { echo "forge-start: physical Git worktree required" >&2; exit 2; }
    SOURCE_ROOT="$(cd "$SOURCE_ROOT" && pwd -P)"
    if [ "${FORGE_START_PROVISION_FAIL:-0}" = 1 ]; then
        echo "forge-start: INJECTED provisioning failure (FORGE_START_PROVISION_FAIL)" >&2
        exit 4
    fi
    if [ "$FORGE_START_WORKTREE" = 1 ]; then
        DIR="$("$FORGE_BIN" worktree ensure --session "$SESSION" --from "$SOURCE_ROOT" \
                 ${ALLOW_DIRTY:+--allow-dirty-base} --print-path)" || exit $?
    else
        DIR="$SOURCE_ROOT"
    fi
fi

# Fail before plain mode creates any tmux state when a Codex upgrade has not
# passed Forge's exact-version containment gate. Populate mode already owns one
# pane; its EXIT trap preserves that pane and reports this distinct reason.
if [ "$FORGE_START_CODEX_PREFLIGHT" = 1 ]; then
    _codex_ready="$("$FORGE_CODEX_DOCTOR_BIN" codex-doctor "$DIR" 2>&1)" || true
    if ! printf '%s\n' "$_codex_ready" | grep -qx 'launch_ready=true'; then
        echo "forge-start: Codex readiness preflight failed before tmux layout; no Codex panes were launched" >&2
        printf '%s\n' "$_codex_ready" >&2
        if [ "$POPULATE" = 1 ]; then
            _FAIL_REASON="Codex readiness preflight failed"
            exit 1
        fi
        exit 3
    fi
fi

# Per-pane role stamps (P1d) — ONLY in populate mode; plain mode keeps the
# byte-identical launch strings (HC4/HC5: forge-1..4 stay stamp-free, structural).
if [ "$POPULATE" = 1 ]; then
    _RP0="FORGE_ROLE=orchestrator "; _RP1="FORGE_ROLE=worker "; _RP2="FORGE_ROLE=worker "
else
    _RP0=""; _RP1=""; _RP2=""
fi

# R8 populate: a spawn-created session carries -e TMUX_SESSION by construction; an
# arbitrary pre-existing 1-pane session may not, and pane 0's already-running child
# cannot be restamped in place. Set the session env and relaunch pane 0 so its child
# inherits the stamp BEFORE we split. Idempotent (no-op when already stamped).
if [ "$POPULATE" = 1 ]; then
    _stamp="$(tmux show-environment -t "$SESSION" TMUX_SESSION 2>/dev/null | sed -n 's/^TMUX_SESSION=//p')"
    if [ "$_stamp" != "$SESSION" ]; then
        tmux set-environment -t "$SESSION" TMUX_SESSION "$SESSION"
        tmux set-environment -t "$SESSION" FORGE_ROOT "$DIR"
        tmux respawn-pane -k -t "$SESSION:.0" -c "$DIR" 2>/dev/null \
            || { echo "ERROR: --populate-existing: could not relaunch pane 0 to apply the TMUX_SESSION stamp on '$SESSION'." >&2; exit 2; }
    fi
fi

# 5-pane split sequence (verified by Phase 2 Step 0 V6). Populate mode inherits
# the existing detached 1-pane session (spawn created it with -c <root>); plain
# mode creates it. Everything from the first split on is identical.
if [ "$POPULATE" = 0 ]; then
    # Stamp session env before any pane child launches.
    tmux new-session -d -s "$SESSION" -c "$DIR" \
        -e "TMUX_SESSION=$SESSION" -e "FORGE_ROOT=$DIR"
fi
PHYSICAL_ROOT="$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null)" || { echo "forge-start: physical Git worktree required" >&2; exit 2; }
PHYSICAL_ROOT="$(cd "$PHYSICAL_ROOT" && pwd -P)"
INCARNATION="$(tmux display-message -p -t "$SESSION" '#{session_created}')"
FORGE_BROKER_BIN="${FORGE_BROKER_BIN:-$HOME/bin/forge-broker}"
"$FORGE_BROKER_BIN" start --root "$PHYSICAL_ROOT" --session "$SESSION" --incarnation "$INCARNATION" --mode "${FORGE_CODEX_ROLLOUT:-contain}" >/dev/null || {
    echo "forge-start: broker failed to start; tearing down the session just created" >&2
    if [ "$POPULATE" = 1 ]; then _FAIL_REASON="broker start failed"; exit 1; fi
    tmux kill-session -t "$SESSION" 2>/dev/null
    exit 3
}
tmux split-window -v -t "$SESSION:.0" -c "$DIR" -p 60; _maybe_fail 1   # 0 = top 40%, 1 = bottom 60%
tmux split-window -h -t "$SESSION:.1" -c "$DIR" -p 50; _maybe_fail 2   # 1 = bottom-left, 2 = bottom-right
tmux split-window -v -t "$SESSION:.1" -c "$DIR" -p 50; _maybe_fail 3   # 1 = L-top, 2 = L-bottom, right → 3
tmux split-window -v -t "$SESSION:.3" -c "$DIR" -p 50; _maybe_fail 4   # 3 = R-top, 4 = R-bottom

# Enable mouse
tmux set -g mouse on

# Launch CLIs in each pane (verified by Phase 2 Step 0 V7). ${_RP*} are EMPTY in
# plain mode (byte-identical to the historical strings); populate mode prepends the
# per-pane FORGE_ROLE stamp (P1d). Codex panes 3/4 are hook-invisible → no role.
tmux send-keys -t "$SESSION:.0" "${_RP0}claude --model claude-opus-5" Enter
tmux send-keys -t "$SESSION:.1" "${_RP1}claude --model claude-opus-5 --permission-mode acceptEdits" Enter
tmux send-keys -t "$SESSION:.2" "${_RP2}claude --model claude-sonnet-5 --permission-mode acceptEdits" Enter
tmux send-keys -t "$SESSION:.3" "forge codex-launch --root '$PHYSICAL_ROOT' --session '$SESSION' --pane 3 --effort xhigh" Enter
tmux send-keys -t "$SESSION:.4" "forge codex-launch --root '$PHYSICAL_ROOT' --session '$SESSION' --pane 4 --effort medium" Enter

# Construction-only geometry proof. Runtime guards use identity receipts, not geometry.
_geo=$(tmux list-panes -t "$SESSION" -F '#{pane_index} #{pane_left} #{pane_top} #{pane_width} #{window_width}')
_bad=$(printf '%s\n' "$_geo" | awk '
  {L[$1]=$2; T[$1]=$3; W[$1]=$4; WW=$5; seen[$1]=1; n++}
  END {
    if (n != 5)                            { print "pane-count=" n; exit }
    for (i=0; i<5; i++) if (!(i in seen)) { print "missing-index=" i; exit }
    if (L[0]!=0 || T[0]!=0 || W[0]!=WW)   { print "pane0-not-full-width-top" }
    if (L[1]!=0 || L[2]!=0)               { print "left-column-must-be-1,2" }
    if (L[3]<=0 || L[3]!=L[4])            { print "right-column-must-be-3,4" }
    if (T[1]!=T[3] || T[2]!=T[4])         { print "grid-rows-misaligned" }
    if (!(T[0]<T[1] && T[1]<T[2]))        { print "row-order-wrong" }
  }')
if [ -n "$_bad" ]; then
    echo "ERROR: forge-start layout invariant failed ($_bad)" >&2
    printf '%s\n' "$_geo" >&2
    if [ "$POPULATE" = 1 ]; then
        exit 1          # EXIT trap reports partial-split + tears down; never kill/rm
    fi
    # This run started the broker for this session at line 140; killing the session
    # here would orphan it. Best effort — the start-side reap is the real backstop.
    "$FORGE_BROKER_BIN" stop --root "$PHYSICAL_ROOT" --timeout 5 >/dev/null 2>&1 || true
    tmux kill-session -t "$SESSION" 2>/dev/null
    rm -f "$DIR/.dev/.forge-session"
    exit 1
fi

# Per-pane identity receipts. Written ONLY after the geometry invariant above passed.
# They attach to pane objects, survive respawn, follow swaps, and are absent on new panes.
tmux set-option -p -t "$SESSION:.0" @forge-worker "claude"
tmux set-option -p -t "$SESSION:.1" @forge-worker "claude-opus"
tmux set-option -p -t "$SESSION:.2" @forge-worker "claude-sonnet"
tmux set-option -p -t "$SESSION:.3" @forge-worker "codex-a"
tmux set-option -p -t "$SESSION:.4" @forge-worker "codex-b"
tmux set-environment -t "$SESSION" FORGE_LAYOUT "$FORGE_LAYOUT_VERSION"

# Focus on pane 0 (orchestrator)
tmux select-pane -t "$SESSION:.0"

# Phase 1b §2.7: wipe stall-check cache for any prior session reusing this name.
# (forge-1 etc. get reused after kill-session; without this, the new session
# inherits stale per-pane snapshots/timestamps from the prior incarnation.)
mkdir -p "$HOME/.cache/forge"
rm -f "$HOME/.cache/forge/${SESSION}-pane"*.snapshot \
      "$HOME/.cache/forge/${SESSION}-pane"*.last-stall-check 2>/dev/null

# Persist session name (advisory only — identity is the host pane; P3.18). Atomic
# temp+rename so a concurrent reader never sees a half-written name.
mkdir -p "$DIR/.dev"
{ printf '# advisory only — identity is the host pane\n%s\n' "$SESSION"; } > "$DIR/.dev/.forge-session.tmp.$$"
mv -f "$DIR/.dev/.forge-session.tmp.$$" "$DIR/.dev/.forge-session"

# Defensive alias drift check; WARN-not-halt.
"$BRIDGE_BIN" alias-self-test --strict || echo "WARN: forge-bridge alias maps drifted or parser skipped entries; investigate before running pipelines" >&2

if [ "$POPULATE" = 1 ]; then _POPULATE_OK=1; fi   # populate succeeded — disarm the failure trap

echo ""
echo "Session '$SESSION' ready."
if [ -f "$DIR/.dev/forge-worktree.json" ]; then
    IFS=$'\t' read -r _wt_branch _wt_base _wt_sha _wt_ahead _wt_trust < <(python3 - "$DIR/.dev/forge-worktree.json" <<'PY'
import json,sys
with open(sys.argv[1]) as f: d=json.load(f)
print("\t".join([d.get("source_branch", ""), d.get("base_ref", ""), d.get("base_sha", ""), str(d.get("source_ahead", 0)), d.get("codex_trust", "absent")]))
PY
)
    echo "  Worktree: $DIR"
    echo "  Branch: $(git -C "$DIR" symbolic-ref --short HEAD 2>/dev/null || echo detached)"
    echo "  Base: $_wt_base @ ${_wt_sha:0:12}"
    [ "${_wt_ahead:-0}" -eq 0 ] || echo "  Source ahead: $_wt_ahead commit(s)"
    echo "  Codex hook trust: $_wt_trust — panes 3/4: run /hooks if prompted"
fi
echo ""
echo "  Pane 0 (top, full width): Claude Opus orchestrator"
echo "  Pane 1 (middle-left):     Claude Opus worker"
echo "  Pane 2 (bottom-left):     Claude Sonnet worker"
echo "  Pane 3 (middle-right):    Codex A"
echo "  Pane 4 (bottom-right):    Codex B"
echo ""
echo "Attach with:  tmux attach -t $SESSION"
echo ""
