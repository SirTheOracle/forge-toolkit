has-session -t forge-1
new-session -d -s forge-1 -c __DIR__ -e TMUX_SESSION=forge-1 -e FORGE_ROOT=__DIR__
split-window -v -t forge-1:.0 -c __DIR__ -p 60
split-window -h -t forge-1:.1 -c __DIR__ -p 50
split-window -v -t forge-1:.1 -c __DIR__ -p 50
split-window -v -t forge-1:.3 -c __DIR__ -p 50
set -g mouse on
send-keys -t forge-1:.0 claude --model claude-opus-5 Enter
send-keys -t forge-1:.1 claude --model claude-opus-5 --permission-mode acceptEdits Enter
send-keys -t forge-1:.2 claude --model claude-sonnet-5 --permission-mode acceptEdits Enter
display-message -p -t forge-1 #{session_created}
send-keys -t forge-1:.3 forge codex-launch --root '__DIR__' --session 'forge-1' --pane 3 --effort xhigh Enter
send-keys -t forge-1:.4 forge codex-launch --root '__DIR__' --session 'forge-1' --pane 4 --effort medium Enter
list-panes -t forge-1 -F #{pane_index} #{pane_left} #{pane_top} #{pane_width} #{window_width}
set-option -p -t forge-1:.0 @forge-worker claude
set-option -p -t forge-1:.1 @forge-worker claude-opus
set-option -p -t forge-1:.2 @forge-worker claude-sonnet
set-option -p -t forge-1:.3 @forge-worker codex-a
set-option -p -t forge-1:.4 @forge-worker codex-b
set-environment -t forge-1 FORGE_LAYOUT 2
select-pane -t forge-1:.0
